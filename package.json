{
  "name": "frost",
  "version": "0.1.0",
  "license": "Apache-2.0",
  "author": "Zohar Zilberman <popen2@gmail.com>",
  "description": "AWS SSO Credentials Refresher",
  "repository": {
    "type": "git",
    "url": "https://github.com/popen2/frost.git"
  },
  "type": "module",
  "main": "./dist/main.js",
  "scripts": {
    "build:icons": "copyfiles --up 1 \"./src/icons/**/TrayIcon*.png\" ./dist/",
    "build:html": "copyfiles --up 1 \"./src/dashboard.html\" ./dist/",
    "build": "tsc && npm run build:icons && npm run build:html",
    "watch": "tsc -w",
    "lint": "eslint src",
    "start": "electron-forge start",
    "package": "electron-forge package",
    "make": "electron-forge make"
  },
  "devDependencies": {
    "@electron-forge/cli": "8.0.0-alpha.10",
    "@electron-forge/maker-zip": "8.0.0-alpha.10",
    "@electron-forge/publisher-github": "8.0.0-alpha.10",
    "@eslint/js": "^10.0.1",
    "@types/electron-prompt": "^1.6.5",
    "@types/ini": "^4.1.1",
    "@types/ws": "^8.18.1",
    "copyfiles": "^2.4.1",
    "electron": "^43.4.0",
    "eslint": "^10.8.1",
    "typescript": "^6.0.3",
    "typescript-eslint": "^8.67.0"
  },
  "dependencies": {
    "@aws-sdk/client-ec2": "^3.1111.0",
    "@aws-sdk/client-eks": "^3.1111.0",
    "@aws-sdk/client-sso": "^3.1111.0",
    "@aws-sdk/client-sso-oidc": "^3.1111.0",
    "@aws-sdk/credential-providers": "^3.1111.0",
    "@kubernetes/client-node": "^2.0.0",
    "delay": "^7.0.0",
    "electron-log": "^5.4.4",
    "electron-prompt": "^1.7.0",
    "electron-store": "^11.0.2",
    "ini": "^7.0.0",
    "js-yaml": "^5.3.0",
    "moment": "^2.30.1",
    "slugify": "^1.6.9",
    "update-electron-app": "^3.3.0",
    "uuid": "^14.0.1"
  }
}
